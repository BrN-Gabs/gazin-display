{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist/server",
    "sourceMap": true
  },
  "include": ["src/server/**/*", "src/shared/**/*", "src/scripts/**/*", "src/generated/**/*"]
}
