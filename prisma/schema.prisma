// GAZIN DISPLAY — modelo de dados
// Migrations versionadas em prisma/migrations (npm run db:migrate / db:deploy)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum UploadStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

enum CommandStatus {
  PENDING
  ACKED
  FAILED
  TIMEOUT
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  name              String
  email             String    @unique
  username          String?   @unique
  passwordHash      String
  role              Role      @default(EDITOR)
  canPublish        Boolean   @default(true)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?

  sessions          Session[]
  media             Media[]
  uploads           UploadSession[]
  playlists         Playlist[]
  publishedVersions PlaylistVersion[]
  auditLogs         AuditLog[]
  commands          DeviceCommand[]
  schedules         Schedule[]
  pairingApprovals  PairingRequest[]
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model Media {
  id               String      @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  originalFilename String
  type             MediaType
  status           MediaStatus @default(PROCESSING)
  mimeType         String
  sizeBytes        BigInt
  originalSize     BigInt?
  durationMs       Int?
  width            Int?
  height           Int?
  videoCodec       String?
  checksum         String?
  storageKey       String?
  originalKey      String?
  thumbnailKey     String?
  previewKey       String?
  transcoded       Boolean     @default(false)
  error            String?
  uploadedById     String?     @db.Uuid
  uploadedBy       User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  playlistItems   PlaylistItem[]
  uploadSessions  UploadSession[]

  @@index([createdAt])
  @@index([type, status])
}

model UploadSession {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename      String
  declaredMime  String?
  totalBytes    BigInt
  receivedBytes BigInt       @default(0)
  status        UploadStatus @default(ACTIVE)
  mediaId       String?      @db.Uuid
  media         Media?       @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  error         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  expiresAt     DateTime

  @@index([status, expiresAt])
}

model Playlist {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  /// Configurações: { loop, audio, fitMode, imageDurationSec, fallbackMediaId }
  settings    Json     @default("{}")
  /// Incrementado a cada alteração do rascunho (controle de concorrência otimista)
  revision    Int      @default(1)
  createdById String?  @db.Uuid
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     PlaylistItem[]
  versions  PlaylistVersion[]
  devices   DisplayDevice[]
  schedules Schedule[]
}

model PlaylistItem {
  id          String   @id @default(uuid()) @db.Uuid
  playlistId  String   @db.Uuid
  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  mediaId     String   @db.Uuid
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  position    Int
  /// Duração personalizada em segundos (somente imagens; nulo = padrão da playlist/sistema)
  durationSec Int?
  settings    Json?

  @@index([playlistId, position])
  @@index([mediaId])
}

model PlaylistVersion {
  id              String   @id @default(uuid()) @db.Uuid
  playlistId      String   @db.Uuid
  playlist        Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  number          Int
  /// Snapshot imutável: { playlist, settings, items[] }
  snapshot        Json
  sourceRevision  Int
  itemCount       Int
  totalDurationMs BigInt   @default(0)
  totalBytes      BigInt   @default(0)
  publishedAt     DateTime @default(now())
  publishedById   String?  @db.Uuid
  publishedBy     User?    @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  /// IDs das mídias referenciadas (para checagem rápida de uso)
  mediaIds        String[] @db.Uuid

  defaultForDevices DisplayDevice[] @relation("DeviceDefaultVersion")

  @@unique([playlistId, number])
  @@index([publishedAt])
}

model DisplayDevice {
  id                 String           @id @default(uuid()) @db.Uuid
  name               String
  identifier         String           @unique
  location           String?
  /// Sobrescritas do dispositivo: { fitMode?, audio? }
  settings           Json             @default("{}")
  playlistId         String?          @db.Uuid
  playlist           Playlist?        @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  publishedVersionId String?          @db.Uuid
  publishedVersion   PlaylistVersion? @relation("DeviceDefaultVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  applyMode          String           @default("next")
  /// Versão-alvo efetiva (padrão ou agendamento) calculada pelo servidor
  effectiveVersionId String?          @db.Uuid
  effectiveSource    String?
  /// Versão que o player reportou estar reproduzindo
  reportedVersionId  String?          @db.Uuid
  lastState          Json?
  lastError          String?
  lastSeenAt         DateTime?
  connectedAt        DateTime?
  disconnectedAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  credentials DeviceCredential[]
  schedules   Schedule[]
  commands    DeviceCommand[]
  auditLogs   AuditLog[]
  pairings    PairingRequest[]
}

model DeviceCredential {
  id         String        @id @default(uuid()) @db.Uuid
  deviceId   String        @db.Uuid
  device     DisplayDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  secretHash String
  createdAt  DateTime      @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  userAgent  String?

  @@index([deviceId])
}

model PairingRequest {
  id               String         @id @default(uuid()) @db.Uuid
  code             String         @unique
  pollSecretHash   String
  createdAt        DateTime       @default(now())
  expiresAt        DateTime
  approvedDeviceId String?        @db.Uuid
  approvedDevice   DisplayDevice? @relation(fields: [approvedDeviceId], references: [id], onDelete: Cascade)
  approvedById     String?        @db.Uuid
  approvedBy       User?          @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  consumedAt       DateTime?
  userAgent        String?

  @@index([expiresAt])
}

model DeviceCommand {
  id          String        @id @default(uuid()) @db.Uuid
  deviceId    String        @db.Uuid
  device      DisplayDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  type        String
  payload     Json?
  status      CommandStatus @default(PENDING)
  result      Json?
  error       String?
  createdById String?       @db.Uuid
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?

  @@index([deviceId, createdAt])
}

model Schedule {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  deviceId    String        @db.Uuid
  device      DisplayDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  playlistId  String        @db.Uuid
  playlist    Playlist      @relation(fields: [playlistId], references: [id], onDelete: Restrict)
  /// Datas locais (America/Sao_Paulo) no formato YYYY-MM-DD; nulas = sem limite
  startDate   String?
  endDate     String?
  /// 0 = domingo ... 6 = sábado
  daysOfWeek  Int[]
  /// HH:mm (America/Sao_Paulo). endTime <= startTime indica janela que atravessa a meia-noite
  startTime   String
  endTime     String
  priority    Int           @default(10)
  enabled     Boolean       @default(true)
  createdById String?       @db.Uuid
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([deviceId, enabled])
}

model AuditLog {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String?        @db.Uuid
  user       User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceId   String?        @db.Uuid
  device     DisplayDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  summary    String
  details    Json?
  ip         String?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

model AppSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
}
