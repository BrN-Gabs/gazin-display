{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": false,
    "paths": { "@/*": ["./src/web/*"] }
  },
  "include": ["src/web/**/*", "src/player/**/*", "src/shared/**/*"],
  "exclude": ["src/player/sw.ts"]
}
