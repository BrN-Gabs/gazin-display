# ============================================================
# GAZIN DISPLAY — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o arquivo .env.
# ============================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# URL pública (usada para validar a origem das requisições — proteção CSRF).
# Em produção: https://display.gazin.com.br
PUBLIC_URL=http://localhost:3000

# Defina "true" quando estiver atrás de proxy reverso (Nginx, Caddy, Traefik)
TRUST_PROXY=false

# ---------------- Banco de dados ----------------
# EMBEDDED_DB=true: o próprio servidor sobe um PostgreSQL embutido (sem Docker, sem instalar nada).
# Os dados ficam em EMBEDDED_DB_DIR. Ele escuta apenas em localhost.
EMBEDDED_DB=true
EMBEDDED_DB_DIR=./.data/postgres
# Com EMBEDDED_DB=true, a senha abaixo é definida na PRIMEIRA execução. Troque ANTES de iniciar pela 1ª vez;
# depois disso, não a altere (ou o servidor não conseguirá conectar).
# Para usar um PostgreSQL externo: EMBEDDED_DB=false e aponte DATABASE_URL para ele.
DATABASE_URL=postgresql://postgres:gazin-dev@localhost:5433/gazin_display
# Aplica migrations automaticamente ao iniciar
AUTO_MIGRATE=true

# ---------------- Administrador inicial ----------------
# Criado ao iniciar se ainda não existir. A senha NÃO é sobrescrita depois (troque-a pelo painel).
# Mín. 10 caracteres com 3 tipos (maiúsculas, minúsculas, números, símbolos).
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@gazin.local
ADMIN_PASSWORD=Trocar-Esta-Senha-1
# true = redefine a senha do ADMIN_EMAIL para ADMIN_PASSWORD na próxima inicialização (use uma vez e volte para false)
ADMIN_RESET_PASSWORD=false

# Cookies Secure (HTTPS). "auto" = true quando PUBLIC_URL começa com https:// (sem PUBLIC_URL: quando NODE_ENV=production).
# Acessando por http:// na rede interna, mantenha "auto" com PUBLIC_URL http://... (ou "false"), senão o login não funciona.
COOKIE_SECURE=auto

# Duração da sessão administrativa (horas, renovada com o uso)
SESSION_TTL_HOURS=12

# Validade da credencial de dispositivo (dias, renovada automaticamente enquanto o telão estiver em uso)
DEVICE_TOKEN_TTL_DAYS=365

# ---------------- Armazenamento ----------------
# local = disco do servidor (volume persistente) | s3 = bucket compatível com S3 (AWS, MinIO, Wasabi...)
STORAGE_DRIVER=local
# Diretório persistente (mídias, thumbnails e uploads temporários). Mesmo com S3, uploads em andamento usam este diretório.
STORAGE_DIR=./storage

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PREFIX=gazin-display/

# ---------------- Uploads ----------------
# Limite máximo absoluto por arquivo (MB). O limite operacional pode ser reduzido em Configurações.
MAX_UPLOAD_MB=20480
# Tamanho de cada parte do upload (MB)
UPLOAD_CHUNK_MB=8

# Caminhos opcionais para ffmpeg/ffprobe. Vazio = binários incluídos via npm (ffmpeg-static / ffprobe-static)
FFMPEG_PATH=
FFPROBE_PATH=

# ---------------- Docker Compose ----------------
# Senha do PostgreSQL criado pelo docker-compose.yml (obrigatória ao usar Compose)
POSTGRES_PASSWORD=
# Porta publicada no host
APP_PORT=3000
